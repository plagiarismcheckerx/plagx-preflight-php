{
    "name": "plagiarismcheckerx/plagx-preflight",
    "description": "Free draft checker for PHP: word count, citation and reference list checks, punctuation and basic grammar suggestions, readability stats. Runs offline. By Plagiarism Checker X.",
    "type": "library",
    "keywords": [
        "draft-checker",
        "essay-checker",
        "grammar-checker",
        "word-count",
        "citation-checker",
        "reference-list",
        "apa",
        "mla",
        "readability",
        "flesch",
        "punctuation",
        "academic-writing",
        "students",
        "laravel"
    ],
    "homepage": "https://github.com/plagiarismcheckerx/plagx-preflight-php",
    "license": "MIT",
    "authors": [
        {
            "name": "Plagiarism Checker X",
            "homepage": "https://plagiarismcheckerx.com/"
        }
    ],
    "support": {
        "issues": "https://github.com/plagiarismcheckerx/plagx-preflight-php/issues",
        "source": "https://github.com/plagiarismcheckerx/plagx-preflight-php"
    },
    "require": {
        "php": ">=8.1",
        "ext-mbstring": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "Plagx\\Preflight\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Plagx\\Preflight\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    }
}
